POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fitfinder
POSTGRES_USER=fitfinder
POSTGRES_PASSWORD=change_me

DB_POOL_MIN=1
DB_POOL_MAX=5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=30.0
OLLAMA_MAX_RETRIES=3

# HNSW beam width at query time — higher = better recall, slightly slower
HNSW_EF_SEARCH=200

# Query expansion: uses LLM to rewrite query with synonyms before embedding.
# Improves recall for vague/short queries. Adds ~3-5s latency (llama3.1 generation).
ENABLE_QUERY_EXPANSION=false
QUERY_EXPANSION_MODEL=llama3.1

# LLM tag enrichment at index time — expands product tags before embedding (offline, no query latency)
ENABLE_TAG_EXPANSION=false

# Cross-encoder reranking: re-scores top candidates by reading query+document jointly.
# Improves ranking precision. Adds ~0.3-0.8s. Downloads ~85MB model on first run.
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES_MULTIPLIER=4

# Prevent huggingface_hub from making network calls on every model load.
# The model is already cached locally after the first run — these checks just add latency.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Score thresholds — candidates below these are dropped from the response.
RERANK_SCORE_THRESHOLD=-2.0
RRF_SCORE_THRESHOLD=0.010

